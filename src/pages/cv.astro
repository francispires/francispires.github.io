---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { cv } from '../data/cv';

const allProjects = await getCollection('projects');

const cvProjects = allProjects
  .filter(p => p.data.startDate)
  .sort((a, b) => (b.data.startDate ?? '').localeCompare(a.data.startDate ?? ''));

const projectCategories = [
  ...new Set(cvProjects.map(p => p.data.category).filter((c): c is string => !!c)),
];

const projectsForJs = cvProjects.map(p => ({
  slug:          p.slug,
  title:         p.data.title,
  titlePt:       p.data.titlePt ?? p.data.title,
  description:   p.data.description,
  descriptionPt: p.data.descriptionPt ?? p.data.description,
  tech:          p.data.tech,
  category:      p.data.category ?? 'misc',
  startDate:     p.data.startDate ?? null,
  endDate:       p.data.endDate ?? null,
  position:      p.data.position ?? null,
  company:       p.data.company ?? null,
}));

const cvStaticData = {
  name:       cv.name,
  headline:   cv.headline,
  contact:    cv.contact,
  summary:    cv.summary,
  experience: cv.experience as unknown as Array<{
    company: string;
    position: { en: string; pt: string };
    startDate: string;
    endDate: string | null;
    location: { en: string; pt: string };
    description: { en: string; pt: string };
  }>,
  education: cv.education as unknown as Array<{
    institution: string;
    degree: { en: string; pt: string };
    field: { en: string; pt: string };
    startYear: number;
    endYear: number;
    note: { en: string; pt: string };
  }>,
  skills: cv.skills as unknown as Array<{ name: string; level: number; category: string }>,
};

function fmtDate(d: string | null | undefined, lang: 'en' | 'pt' = 'en'): string {
  if (!d) return lang === 'pt' ? 'atual' : 'present';
  const [year, month] = d.split('-');
  const enM = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const ptM = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
  return `${(lang === 'pt' ? ptM : enM)[parseInt(month) - 1]} ${year}`;
}

function catColor(cat: string): string {
  const map: Record<string, string> = {
    'csharp': '#00d4ff', 'typescript': '#00d4ff', 'javascript': '#ffb800',
    'python': '#00ff87', 'sql': '#00d4ff', 'data-engineering': '#00ff87',
    'devops': '#ffb800', 'math': '#00d4ff', 'misc': '#6b7280',
    'leadership': '#00ff87', 'ai': '#00d4ff',
  };
  return map[cat] ?? '#6b7280';
}
---

<BaseLayout
  title="CV — Francis Pires"
  description="Francis Pires — software engineer with 26+ years of experience. Full-stack, .NET Core, Azure, SQL Server."
>
  <div class="cv-page">

    <!-- ── Page header ─────────────────────────────────────────────────── -->
    <div class="cv-header">
      <div class="cv-header-left">
        <span class="cmd-prefix">$ cat curriculum.pdf</span>
        <h1 class="cv-title">
          <span class="lang-en">Curriculum Vitae</span>
          <span class="lang-pt">Currículo</span>
        </h1>
      </div>
      <div class="cv-header-right">
        <div class="filter-chips" id="filter-chips">
          {projectCategories.map(cat => (
            <button class="cat-chip active" data-cat={cat} style={`--chip-color: ${catColor(cat)}`}>
              {cat} ✓
            </button>
          ))}
        </div>
        <button class="pdf-btn" id="pdf-btn">
          <span class="lang-en">⬇ Download PDF</span>
          <span class="lang-pt">⬇ Baixar PDF</span>
        </button>
      </div>
    </div>

    <!-- ── Two-column layout ───────────────────────────────────────────── -->
    <div class="cv-body">

      <!-- Sidebar -->
      <aside class="cv-sidebar">
        <div class="sidebar-photo">
          <img src={cv.photo} alt="Francis Pires" class="photo-img" />
        </div>
        <div class="sidebar-name">{cv.name.toUpperCase()}</div>
        <div class="sidebar-headline">
          <span class="lang-en">{cv.headline.en}</span>
          <span class="lang-pt">{cv.headline.pt}</span>
        </div>

        <div class="sidebar-section-label">── CONTACT ──</div>
        <div class="contact-item">📧 {cv.contact.email}</div>
        <div class="contact-item">🔗 {cv.contact.github}</div>
        <div class="contact-item">🌐 {cv.contact.site}</div>
        <div class="contact-item lang-en">📍 {cv.contact.city.en}</div>
        <div class="contact-item lang-pt">📍 {cv.contact.city.pt}</div>

        <div class="sidebar-section-label">── SKILLS ──</div>
        {cvStaticData.skills.map(skill => (
          <div class="skill-row">
            <span class="skill-name">{skill.name}</span>
            <div class="skill-bar-bg">
              <div class="skill-bar-fill" style={`width: ${skill.level}%`}></div>
            </div>
          </div>
        ))}

        <div class="sidebar-section-label">── EDUCATION ──</div>
        {cvStaticData.education.map(edu => (
          <div class="edu-entry">
            <div class="edu-institution">{edu.institution}</div>
            <div class="edu-degree lang-en">{edu.degree.en}</div>
            <div class="edu-degree lang-pt">{edu.degree.pt}</div>
            <div class="edu-years">{edu.startYear} – {edu.endYear}</div>
          </div>
        ))}
      </aside>

      <!-- Main column -->
      <div class="cv-main">

        <!-- Summary -->
        <section class="cv-section">
          <div class="section-cmd">$ whoami</div>
          <div class="summary-text lang-en">{cv.summary.en}</div>
          <div class="summary-text lang-pt">{cv.summary.pt}</div>
        </section>

        <!-- Experience -->
        <section class="cv-section">
          <div class="section-cmd">$ cat experience.log</div>
          {cvStaticData.experience.map((exp, i) => (
            <div class={`exp-entry${i === 0 ? ' exp-active' : ''}`}>
              <div class="exp-header">
                <span class="exp-title lang-en">{exp.position.en}</span>
                <span class="exp-title lang-pt">{exp.position.pt}</span>
                <span class="exp-date">
                  <span class="lang-en">{fmtDate(exp.startDate, 'en')} – {fmtDate(exp.endDate, 'en')}</span>
                  <span class="lang-pt">{fmtDate(exp.startDate, 'pt')} – {fmtDate(exp.endDate, 'pt')}</span>
                </span>
              </div>
              <div class="exp-company">{exp.company}</div>
              <div class="exp-location lang-en">{exp.location.en}</div>
              <div class="exp-location lang-pt">{exp.location.pt}</div>
              <div class="exp-desc lang-en">{exp.description.en}</div>
              <div class="exp-desc lang-pt">{exp.description.pt}</div>
            </div>
          ))}
        </section>

        <!-- Projects (client-filtered) -->
        <section class="cv-section">
          <div class="section-cmd" style="color: var(--cyan)">$ ls projects/ | sort -r</div>
          <div id="cv-projects">
            {cvProjects.map(p => (
              <div class="proj-entry" data-cat={p.data.category} data-slug={p.slug}>
                <div class="proj-header">
                  <span class="proj-title lang-en">{p.data.title}</span>
                  <span class="proj-title lang-pt">{p.data.titlePt ?? p.data.title}</span>
                  <span class="proj-date">
                    <span class="lang-en">{fmtDate(p.data.startDate, 'en')} – {fmtDate(p.data.endDate, 'en')}</span>
                    <span class="lang-pt">{fmtDate(p.data.startDate, 'pt')} – {fmtDate(p.data.endDate, 'pt')}</span>
                  </span>
                </div>
                {(p.data.position || p.data.company) && (
                  <div class="proj-role">
                    {[p.data.position, p.data.company].filter(Boolean).join(' · ')}
                  </div>
                )}
                <div class="proj-tech">
                  {p.data.tech.slice(0, 5).map(t => (
                    <span class="tech-tag">{t}</span>
                  ))}
                </div>
                <div class="proj-desc lang-en">{p.data.description}</div>
                <div class="proj-desc lang-pt">{p.data.descriptionPt ?? p.data.description}</div>
              </div>
            ))}
          </div>
          <div class="projects-count" id="projects-count"></div>
        </section>

      </div>
    </div>
  </div>

  <!-- Inject build-time data for client scripts -->
  <script define:vars={{ cvProjects: projectsForJs, cvStaticData }}>
    window.__cvProjects = cvProjects;
    window.__cvStaticData = cvStaticData;
  </script>

  <script>
    // ── Category filter ────────────────────────────────────────────────
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.cat-chip'));
    const projectEls = Array.from(document.querySelectorAll<HTMLElement>('.proj-entry'));
    const countEl = document.getElementById('projects-count');

    function getActiveCats(): string[] {
      return chips
        .filter(c => c.classList.contains('active'))
        .map(c => c.dataset.cat ?? '');
    }

    function updateProjects() {
      const active = getActiveCats();
      let shown = 0;
      projectEls.forEach(el => {
        const visible = active.includes(el.dataset.cat ?? '');
        el.style.display = visible ? '' : 'none';
        if (visible) shown++;
      });
      if (countEl) {
        const lang = document.documentElement.getAttribute('data-lang') === 'pt-BR' ? 'pt' : 'en';
        const total = projectEls.length;
        countEl.textContent = lang === 'pt'
          ? `↑ mostrando ${shown} de ${total} projeto${total !== 1 ? 's' : ''}`
          : `↑ showing ${shown} of ${total} project${total !== 1 ? 's' : ''}`;
      }
    }

    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        const wasActive = chip.classList.toggle('active');
        chip.textContent = wasActive ? `${chip.dataset.cat} ✓` : (chip.dataset.cat ?? '');
        updateProjects();
      });
    });

    updateProjects();
    document.documentElement.addEventListener('langchange', () => updateProjects());

    // ── PDF download ───────────────────────────────────────────────────
    document.getElementById('pdf-btn')?.addEventListener('click', async () => {
      const btn = document.getElementById('pdf-btn') as HTMLButtonElement;
      const origHTML = btn.innerHTML;
      btn.textContent = '⏳ Gerando...';
      btn.disabled = true;

      try {
        // Dynamic import — Vite code-splits pdfmake so it only loads on click
        const [pdfMakeModule, pdfFontsModule] = await Promise.all([
          import('pdfmake/build/pdfmake'),
          import('pdfmake/build/vfs_fonts'),
        ]);

        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const pdfMake = (pdfMakeModule as any).default ?? pdfMakeModule;
        // pdfmake 0.3.x: vfs_fonts default export IS the vfs object directly
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const pdfFonts = (pdfFontsModule as any).default ?? pdfFontsModule;
        pdfMake.vfs = typeof pdfFonts === 'object' && 'Roboto-Regular.ttf' in pdfFonts
          ? pdfFonts
          : (pdfFonts?.pdfMake?.vfs ?? pdfFonts?.vfs ?? {});

        const lang = document.documentElement.getAttribute('data-lang') === 'pt-BR' ? 'pt' : 'en';
        const activeCats = getActiveCats();

        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const allProjects: any[] = (window as any).__cvProjects ?? [];
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const d: any = (window as any).__cvStaticData ?? {};

        const filtered = allProjects.filter((p: { category: string }) => activeCats.includes(p.category));

        // Fetch photo as base64
        let photoData: string | null = null;
        try {
          const resp = await fetch('/img/fran.jpg');
          const blob = await resp.blob();
          photoData = await new Promise<string>(resolve => {
            const reader = new FileReader();
            reader.onload = () => resolve(reader.result as string);
            reader.readAsDataURL(blob);
          });
        } catch (_) { /* photo optional */ }

        const GREEN  = '#00ff87';
        const CYAN   = '#00d4ff';
        const AMBER  = '#ffb800';
        const DARK   = '#161b22';
        const TEXT   = '#e6edf3';
        const MUTED  = '#8b949e';
        const SIDEBAR_W = 185;

        function fmt(date: string | null | undefined): string {
          if (!date) return lang === 'pt' ? 'atual' : 'present';
          const [y, m] = date.split('-');
          const enM = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
          const ptM = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
          return `${(lang === 'pt' ? ptM : enM)[parseInt(m) - 1]} ${y}`;
        }

        // ── Sidebar content ──
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const sidebarItems: any[] = [];

        if (photoData) {
          sidebarItems.push({
            image: photoData,
            width: 72,
            height: 72,
            alignment: 'center',
            margin: [0, 0, 0, 10],
          });
        }

        sidebarItems.push(
          { text: d.name?.toUpperCase() ?? '', fontSize: 10, bold: true, color: TEXT, alignment: 'center', margin: [0, 0, 0, 4] },
          { text: lang === 'pt' ? d.headline?.pt : d.headline?.en, fontSize: 6.5, color: GREEN, alignment: 'center', margin: [0, 0, 0, 14], lineHeight: 1.3 },
          { text: '── CONTACT ──', fontSize: 7, bold: true, color: AMBER, margin: [0, 0, 0, 6] },
          { text: d.contact?.email ?? '', fontSize: 7, color: MUTED, margin: [0, 0, 0, 2] },
          { text: d.contact?.github ?? '', fontSize: 7, color: MUTED, margin: [0, 0, 0, 2] },
          { text: d.contact?.site ?? '', fontSize: 7, color: MUTED, margin: [0, 0, 0, 2] },
          { text: lang === 'pt' ? (d.contact?.city?.pt ?? '') : (d.contact?.city?.en ?? ''), fontSize: 7, color: MUTED, margin: [0, 0, 0, 14] },
          { text: '── SKILLS ──', fontSize: 7, bold: true, color: AMBER, margin: [0, 0, 0, 8] },
        );

        (d.skills ?? []).forEach((skill: { name: string; level: number }) => {
          const barW = 140;
          const fillW = Math.round(barW * skill.level / 100);
          sidebarItems.push({
            stack: [
              { text: skill.name, fontSize: 7, color: TEXT },
              { canvas: [
                { type: 'rect', x: 0, y: 2, w: barW, h: 4, color: '#21262d', r: 2 },
                { type: 'rect', x: 0, y: 2, w: fillW, h: 4, color: GREEN, r: 2 },
              ]},
            ],
            margin: [0, 0, 0, 6],
          });
        });

        sidebarItems.push({ text: '── EDUCATION ──', fontSize: 7, bold: true, color: AMBER, margin: [0, 12, 0, 8] });
        (d.education ?? []).forEach((edu: { institution: string; degree: { en: string; pt: string }; startYear: number; endYear: number }) => {
          sidebarItems.push({
            stack: [
              { text: edu.institution, fontSize: 7, color: TEXT, bold: true },
              { text: lang === 'pt' ? edu.degree.pt : edu.degree.en, fontSize: 6.5, color: MUTED },
              { text: `${edu.startYear} – ${edu.endYear}`, fontSize: 6.5, color: MUTED },
            ],
            margin: [0, 0, 0, 8],
          });
        });

        // ── Main content ──
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const mainItems: any[] = [];

        mainItems.push(
          { text: '$ whoami', fontSize: 9, color: GREEN, bold: true, margin: [0, 0, 0, 6] },
          { text: lang === 'pt' ? d.summary?.pt : d.summary?.en, fontSize: 8, color: MUTED, lineHeight: 1.4, margin: [0, 0, 0, 18] },
          { text: '$ cat experience.log', fontSize: 9, color: GREEN, bold: true, margin: [0, 0, 0, 8] },
        );

        (d.experience ?? []).forEach((exp: {
          company: string;
          position: { en: string; pt: string };
          startDate: string;
          endDate: string | null;
          location: { en: string; pt: string };
          description: { en: string; pt: string };
        }) => {
          mainItems.push({
            stack: [
              {
                columns: [
                  { text: lang === 'pt' ? exp.position.pt : exp.position.en, fontSize: 9, bold: true, color: TEXT, width: '*' },
                  { text: `${fmt(exp.startDate)} – ${fmt(exp.endDate)}`, fontSize: 7, color: MUTED, alignment: 'right', width: 'auto' },
                ],
              },
              { text: exp.company, fontSize: 8, color: CYAN, margin: [0, 2, 0, 2] },
              { text: lang === 'pt' ? exp.location.pt : exp.location.en, fontSize: 7, color: MUTED, margin: [0, 0, 0, 2] },
              { text: lang === 'pt' ? exp.description.pt : exp.description.en, fontSize: 7.5, color: MUTED, lineHeight: 1.3 },
            ],
            margin: [0, 0, 0, 10],
          });
        });

        if (filtered.length > 0) {
          mainItems.push({ text: '$ ls projects/ | sort -r', fontSize: 9, color: CYAN, bold: true, margin: [0, 10, 0, 8] });
          // eslint-disable-next-line @typescript-eslint/no-explicit-any
          filtered.forEach((proj: any) => {
            mainItems.push({
              stack: [
                {
                  columns: [
                    { text: lang === 'pt' ? proj.titlePt : proj.title, fontSize: 9, bold: true, color: TEXT, width: '*' },
                    { text: `${fmt(proj.startDate)} – ${fmt(proj.endDate)}`, fontSize: 7, color: MUTED, alignment: 'right', width: 'auto' },
                  ],
                },
                ...([proj.position, proj.company].filter(Boolean).length > 0 ? [
                  { text: [proj.position, proj.company].filter(Boolean).join(' · '), fontSize: 8, color: CYAN, margin: [0, 2, 0, 2] },
                ] : []),
                { text: (proj.tech as string[]).slice(0, 5).join(' · '), fontSize: 7, color: GREEN, margin: [0, 0, 0, 2] },
                { text: lang === 'pt' ? proj.descriptionPt : proj.description, fontSize: 7.5, color: MUTED, lineHeight: 1.3 },
              ],
              margin: [0, 0, 0, 10],
            });
          });
        }

        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const docDefinition: any = {
          pageSize: 'A4',
          pageMargins: [0, 0, 0, 0],
          background: (_page: number, pageSize: { height: number }) => ({
            canvas: [{
              type: 'rect',
              x: 0, y: 0,
              w: SIDEBAR_W,
              h: pageSize.height,
              color: DARK,
            }],
          }),
          content: [{
            columns: [
              { width: SIDEBAR_W, stack: sidebarItems, margin: [14, 24, 10, 24] },
              { width: '*',       stack: mainItems,    margin: [18, 24, 22, 24] },
            ],
          }],
          defaultStyle: {
            font: 'Roboto',
            fontSize: 9,
            color: TEXT,
          },
        };

        pdfMake.createPdf(docDefinition).download('francis-pires-cv.pdf');
      } catch (err) {
        console.error('PDF generation failed:', err);
        alert('PDF generation failed. Check the console for details.');
      } finally {
        btn.innerHTML = origHTML;
        btn.disabled = false;
      }
    });
  </script>

  <style>
    .cv-page {
      max-width: var(--wide-width);
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }

    /* ── Header ──────────────────────────────────────────────────────── */
    .cv-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
    }

    .cmd-prefix {
      color: var(--green);
      font-size: 0.75rem;
      display: block;
      margin-bottom: 0.25rem;
    }

    .cv-title {
      font-size: 1.5rem;
      color: var(--text);
    }

    .cv-header-right {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .filter-chips {
      display: flex;
      gap: 0.375rem;
      flex-wrap: wrap;
    }

    .cat-chip {
      background: color-mix(in srgb, var(--chip-color) 14%, transparent);
      color: var(--chip-color);
      border: 1px solid color-mix(in srgb, var(--chip-color) 40%, transparent);
      border-radius: 3px;
      padding: 0.2rem 0.6rem;
      font-size: 0.7rem;
      font-family: var(--font-mono);
      cursor: pointer;
      transition: background 0.15s, color 0.15s, border-color 0.15s;
    }

    .cat-chip:not(.active) {
      background: var(--bg-elevated);
      color: var(--text-muted);
      border-color: var(--border);
    }

    .pdf-btn {
      background: var(--green);
      color: #0d0d0d;
      border: none;
      border-radius: 3px;
      padding: 0.35rem 1rem;
      font-size: 0.75rem;
      font-family: var(--font-mono);
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
      transition: opacity 0.15s;
    }

    .pdf-btn:hover:not(:disabled) { opacity: 0.85; }
    .pdf-btn:disabled { opacity: 0.6; cursor: not-allowed; }

    /* ── Two-column body ──────────────────────────────────────────────── */
    .cv-body {
      display: flex;
      border: 1px solid var(--border);
      border-radius: 6px;
      overflow: hidden;
    }

    /* ── Sidebar ──────────────────────────────────────────────────────── */
    .cv-sidebar {
      width: 220px;
      flex-shrink: 0;
      background: #161b22;
      border-right: 1px solid var(--border);
      padding: 1.5rem 1rem;
    }

    .sidebar-photo { text-align: center; margin-bottom: 0.75rem; }

    .photo-img {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      border: 2px solid var(--green);
      object-fit: cover;
    }

    .sidebar-name {
      text-align: center;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--text);
      letter-spacing: 0.08em;
      margin-bottom: 0.25rem;
    }

    .sidebar-headline {
      text-align: center;
      font-size: 0.62rem;
      color: var(--green);
      line-height: 1.45;
      margin-bottom: 0.5rem;
    }

    .sidebar-section-label {
      color: var(--amber);
      font-size: 0.62rem;
      margin: 1rem 0 0.5rem;
      letter-spacing: 0.05em;
    }

    .contact-item {
      color: var(--text-muted);
      font-size: 0.68rem;
      margin-bottom: 0.2rem;
      word-break: break-all;
    }

    .skill-row { margin-bottom: 0.45rem; }

    .skill-name {
      display: block;
      font-size: 0.68rem;
      color: var(--text);
      margin-bottom: 0.2rem;
    }

    .skill-bar-bg {
      height: 4px;
      background: #21262d;
      border-radius: 2px;
      overflow: hidden;
    }

    .skill-bar-fill {
      height: 100%;
      background: var(--green);
      border-radius: 2px;
    }

    .edu-entry { margin-bottom: 0.75rem; }

    .edu-institution {
      font-size: 0.68rem;
      color: var(--text);
      font-weight: 600;
    }

    .edu-degree {
      font-size: 0.64rem;
      color: var(--text-muted);
      line-height: 1.4;
    }

    .edu-years {
      font-size: 0.62rem;
      color: var(--text-dim);
    }

    /* ── Main column ──────────────────────────────────────────────────── */
    .cv-main {
      flex: 1;
      padding: 1.5rem 1.75rem;
      min-width: 0;
    }

    .cv-section { margin-bottom: 2rem; }

    .section-cmd {
      color: var(--green);
      font-size: 0.8rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
      letter-spacing: 0.03em;
    }

    .summary-text {
      font-size: 0.8rem;
      color: var(--text-muted);
      line-height: 1.65;
      border-left: 2px solid var(--border);
      padding-left: 0.75rem;
    }

    /* Experience */
    .exp-entry {
      border-left: 2px solid var(--border);
      padding-left: 0.75rem;
      margin-bottom: 1.1rem;
    }

    .exp-entry.exp-active { border-color: var(--green); }

    .exp-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .exp-title {
      font-size: 0.875rem;
      font-weight: 700;
      color: var(--text);
    }

    .exp-date { font-size: 0.7rem; color: var(--text-muted); white-space: nowrap; }
    .exp-company { font-size: 0.8rem; color: var(--cyan); margin: 0.15rem 0; }
    .exp-location { font-size: 0.68rem; color: var(--text-dim); margin-bottom: 0.2rem; }

    .exp-desc {
      font-size: 0.775rem;
      color: var(--text-muted);
      line-height: 1.55;
    }

    /* Projects */
    .proj-entry {
      border-left: 2px solid var(--cyan);
      padding-left: 0.75rem;
      margin-bottom: 1.1rem;
    }

    .proj-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .proj-title { font-size: 0.875rem; font-weight: 700; color: var(--text); }
    .proj-date  { font-size: 0.7rem; color: var(--text-muted); white-space: nowrap; }
    .proj-role  { font-size: 0.775rem; color: var(--cyan); margin: 0.15rem 0; }

    .proj-tech {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem;
      margin: 0.25rem 0;
    }

    .tech-tag {
      background: rgba(0, 255, 135, 0.08);
      color: var(--green);
      font-size: 0.64rem;
      padding: 0.1rem 0.35rem;
      border-radius: 2px;
    }

    .proj-desc {
      font-size: 0.775rem;
      color: var(--text-muted);
      line-height: 1.55;
    }

    .projects-count {
      font-size: 0.7rem;
      color: var(--text-dim);
      font-style: italic;
      margin-top: 0.5rem;
      padding-left: 0.75rem;
    }

    /* ── Responsive ────────────────────────────────────────────────────── */
    @media (max-width: 720px) {
      .cv-body { flex-direction: column; }
      .cv-sidebar { width: 100%; border-right: none; border-bottom: 1px solid var(--border); }
      .cv-header { flex-direction: column; }
      .cv-header-right { flex-direction: column; align-items: flex-start; }
    }
  </style>
</BaseLayout>
