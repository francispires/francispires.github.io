    .sidebar-section-label {
      color: var(--amber);
      font-size: 0.62rem;
      margin: 1rem 0 0.5rem;
      letter-spacing: 0.05em;
    }

    .contact-item {
      color: var(--text-muted);
      font-size: 0.68rem;
      margin-bottom: 0.2rem;
