    }

    .edu-years {
      font-size: 0.62rem;
      color: var(--text-dim);
    }

    /* ── Main column ──────────────────────────────────────────────────── */
    .cv-main {
      flex: 1;
      padding: 1.5rem 1.75rem;
      min-width: 0;
    }

    .cv-section { margin-bottom: 2rem; }

    .section-cmd {
      color: var(--green);
      font-size: 0.8rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
      letter-spacing: 0.03em;
    }

    .summary-text {
      font-size: 0.8rem;
