---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { cv } from '../data/cv';

const allProjects = await getCollection('projects');

const cvProjects = allProjects
  .filter(p => p.data.startDate)
  .sort((a, b) => (b.data.startDate ?? '').localeCompare(a.data.startDate ?? ''));

const projectCategories = [
  ...new Set(cvProjects.map(p => p.data.category).filter((c): c is string => !!c)),
];

const projectsForJs = cvProjects.map(p => ({
  slug:          p.slug,
  title:         p.data.title,
  titlePt:       p.data.titlePt ?? p.data.title,
  description:   p.data.description,
  descriptionPt: p.data.descriptionPt ?? p.data.description,
  tech:          p.data.tech,
  category:      p.data.category ?? 'misc',
  startDate:     p.data.startDate ?? null,
  endDate:       p.data.endDate ?? null,
  position:      p.data.position ?? null,
  company:       p.data.company ?? null,
}));

const cvStaticData = {
  name:       cv.name,
  headline:   cv.headline,
  contact:    cv.contact,
  summary:    cv.summary,
  experience: cv.experience as unknown as Array<{
    company: string;
    position: { en: string; pt: string };
    startDate: string;
    endDate: string | null;
    location: { en: string; pt: string };
    description: { en: string; pt: string };
  }>,
  education: cv.education as unknown as Array<{
    institution: string;
    degree: { en: string; pt: string };
    field: { en: string; pt: string };
    startYear: number;
    endYear: number;
    note: { en: string; pt: string };
  }>,
  skills: cv.skills as unknown as Array<{ name: string; level: number; category: string }>,
};

function fmtDate(d: string | null | undefined, lang: 'en' | 'pt' = 'en'): string {
  if (!d) return lang === 'pt' ? 'atual' : 'present';
  const [year, month] = d.split('-');
  const enM = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const ptM = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
  return `${(lang === 'pt' ? ptM : enM)[parseInt(month) - 1]} ${year}`;
}

function catColor(cat: string): string {
  const map: Record<string, string> = {
    'csharp': '#00d4ff', 'typescript': '#00d4ff', 'javascript': '#ffb800',
    'python': '#00ff87', 'sql': '#00d4ff', 'data-engineering': '#00ff87',
    'devops': '#ffb800', 'math': '#00d4ff', 'misc': '#6b7280',
    'leadership': '#00ff87', 'ai': '#00d4ff',
  };
  return map[cat] ?? '#6b7280';
}
---

<BaseLayout
  title="CV — Francis Pires"
  description="Francis Pires — software engineer with 26+ years of experience. Full-stack, .NET Core, Azure, SQL Server."
>
  <div class="cv-page">

    <!-- ── Page header ─────────────────────────────────────────────────── -->
    <div class="cv-header">
      <div class="cv-header-left">
        <span class="cmd-prefix">$ cat curriculum.pdf</span>
        <h1 class="cv-title">
          <span class="lang-en">Curriculum Vitae</span>
          <span class="lang-pt">Currículo</span>
        </h1>
      </div>
      <div class="cv-header-right">
        <div class="filter-chips" id="filter-chips">
          {projectCategories.map(cat => (
            <button class="cat-chip active" data-cat={cat} style={`--chip-color: ${catColor(cat)}`}>
              {cat} ✓
            </button>
          ))}
        </div>
        <button class="pdf-btn pdf-btn-dark" id="pdf-btn-dark">
          <span class="lang-en">⬇ Dark PDF</span>
          <span class="lang-pt">⬇ PDF Escuro</span>
        </button>
        <button class="pdf-btn pdf-btn-light" id="pdf-btn-light">
          <span class="lang-en">⬇ Light PDF</span>
          <span class="lang-pt">⬇ PDF Claro</span>
        </button>
      </div>
    </div>

    <!-- ── Two-column layout ───────────────────────────────────────────── -->
    <div class="cv-body">

      <!-- Sidebar -->
      <aside class="cv-sidebar">
        <div class="sidebar-photo">
          <img src={cv.photo} alt="Francis Pires" class="photo-img" />
        </div>
        <div class="sidebar-name">{cv.name.toUpperCase()}</div>
        <div class="sidebar-headline">
          <span class="lang-en">{cv.headline.en}</span>
          <span class="lang-pt">{cv.headline.pt}</span>
        </div>

        <div class="sidebar-section-label">── CONTACT ──</div>
        <div class="contact-item">📧 {cv.contact.email}</div>
        <div class="contact-item">🔗 {cv.contact.github}</div>
        <div class="contact-item">🌐 {cv.contact.site}</div>
        <div class="contact-item lang-en">📍 {cv.contact.city.en}</div>
        <div class="contact-item lang-pt">📍 {cv.contact.city.pt}</div>

        <div class="sidebar-section-label">── SKILLS ──</div>
        {cvStaticData.skills.map(skill => (
          <div class="skill-row">
            <span class="skill-name">{skill.name}</span>
            <div class="skill-bar-bg">
              <div class="skill-bar-fill" style={`width: ${skill.level}%`}></div>
            </div>
          </div>
        ))}

        <div class="sidebar-section-label">── EDUCATION ──</div>
        {cvStaticData.education.map(edu => (
          <div class="edu-entry">
            <div class="edu-institution">{edu.institution}</div>
            <div class="edu-degree lang-en">{edu.degree.en}</div>
            <div class="edu-degree lang-pt">{edu.degree.pt}</div>
            <div class="edu-years">{edu.startYear} – {edu.endYear}</div>
          </div>
        ))}
      </aside>

      <!-- Main column -->
      <div class="cv-main">

        <!-- Summary -->
        <section class="cv-section">
          <div class="section-cmd">$ whoami</div>
          <div class="summary-text lang-en">{cv.summary.en}</div>
          <div class="summary-text lang-pt">{cv.summary.pt}</div>
        </section>

        <!-- Experience -->
        <section class="cv-section">
          <div class="section-cmd">$ cat experience.log</div>
          {cvStaticData.experience.map((exp, i) => (
            <div class={`exp-entry${i === 0 ? ' exp-active' : ''}`}>
              <div class="exp-header">
                <span class="exp-title lang-en">{exp.position.en}</span>
                <span class="exp-title lang-pt">{exp.position.pt}</span>
                <span class="exp-date">
                  <span class="lang-en">{fmtDate(exp.startDate, 'en')} – {fmtDate(exp.endDate, 'en')}</span>
                  <span class="lang-pt">{fmtDate(exp.startDate, 'pt')} – {fmtDate(exp.endDate, 'pt')}</span>
                </span>
              </div>
              <div class="exp-company">{exp.company}</div>
              <div class="exp-location lang-en">{exp.location.en}</div>
              <div class="exp-location lang-pt">{exp.location.pt}</div>
              <div class="exp-desc lang-en">{exp.description.en}</div>
              <div class="exp-desc lang-pt">{exp.description.pt}</div>
            </div>
          ))}
        </section>

        <!-- Projects (client-filtered) -->
        <section class="cv-section">
          <div class="section-cmd" style="color: var(--cyan)">$ ls projects/ | sort -r</div>
          <div id="cv-projects">
            {cvProjects.map(p => (
              <div class="proj-entry" data-cat={p.data.category} data-slug={p.slug}>
                <div class="proj-header">
                  <span class="proj-title lang-en">{p.data.title}</span>
                  <span class="proj-title lang-pt">{p.data.titlePt ?? p.data.title}</span>
                  <span class="proj-date">
                    <span class="lang-en">{fmtDate(p.data.startDate, 'en')} – {fmtDate(p.data.endDate, 'en')}</span>
                    <span class="lang-pt">{fmtDate(p.data.startDate, 'pt')} – {fmtDate(p.data.endDate, 'pt')}</span>
                  </span>
                </div>
                {(p.data.position || p.data.company) && (
                  <div class="proj-role">
                    {[p.data.position, p.data.company].filter(Boolean).join(' · ')}
                  </div>
                )}
                <div class="proj-tech">
                  {p.data.tech.slice(0, 5).map(t => (
                    <span class="tech-tag">{t}</span>
                  ))}
                </div>
                <div class="proj-desc lang-en">{p.data.description}</div>
                <div class="proj-desc lang-pt">{p.data.descriptionPt ?? p.data.description}</div>
              </div>
            ))}
          </div>
          <div class="projects-count" id="projects-count"></div>
        </section>

      </div>
    </div>
  </div>

  <!-- Inject build-time data for client scripts -->
  <script define:vars={{ cvProjects: projectsForJs, cvStaticData }}>
    window.__cvProjects = cvProjects;
    window.__cvStaticData = cvStaticData;
  </script>

  <script>
    // ── Category filter ────────────────────────────────────────────────
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.cat-chip'));
    const projectEls = Array.from(document.querySelectorAll<HTMLElement>('.proj-entry'));
    const countEl = document.getElementById('projects-count');

    function getActiveCats(): string[] {
      return chips
        .filter(c => c.classList.contains('active'))
        .map(c => c.dataset.cat ?? '');
    }

    function updateProjects() {
      const active = getActiveCats();
      let shown = 0;
      projectEls.forEach(el => {
        const visible = active.includes(el.dataset.cat ?? '');
        el.style.display = visible ? '' : 'none';
        if (visible) shown++;
      });
      if (countEl) {
        const lang = document.documentElement.getAttribute('data-lang') === 'pt-BR' ? 'pt' : 'en';
        const total = projectEls.length;
        countEl.textContent = lang === 'pt'
          ? `↑ mostrando ${shown} de ${total} projeto${total !== 1 ? 's' : ''}`
          : `↑ showing ${shown} of ${total} project${total !== 1 ? 's' : ''}`;
      }
    }

    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        const wasActive = chip.classList.toggle('active');
        chip.textContent = wasActive ? `${chip.dataset.cat} ✓` : (chip.dataset.cat ?? '');
        updateProjects();
      });
    });

    updateProjects();
    document.documentElement.addEventListener('langchange', () => updateProjects());

    // ── PDF download ───────────────────────────────────────────────────
    async function downloadPDF(theme: 'dark' | 'light') {
      // Load pdfmake FIRST, expose on window, then load vfs_fonts.
      // vfs_fonts.js calls window.pdfMake.addVirtualFileSystem(vfs) when window.pdfMake
      // is already set — this is the reliable VFS registration path in pdfmake 0.3.x.
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      const pdfMakeModule = await import('pdfmake/build/pdfmake');
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      const pdfMake: any = (pdfMakeModule as any).default ?? pdfMakeModule;
      (window as any).pdfMake = pdfMake;
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      const pdfFontsModule = await import('pdfmake/build/vfs_fonts');
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      const vfsDirect: any = (pdfFontsModule as any).default ?? pdfFontsModule;
      if (vfsDirect && typeof vfsDirect === 'object' && !pdfMake.vfs?.['Roboto-Regular.ttf']) {
        pdfMake.vfs = vfsDirect;
      }

      const lang = document.documentElement.getAttribute('data-lang') === 'pt-BR' ? 'pt' : 'en';
      const activeCats = getActiveCats();
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      const allProjects: any[] = (window as any).__cvProjects ?? [];
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      const d: any = (window as any).__cvStaticData ?? {};
      const filtered = allProjects.filter((p: { category: string }) => activeCats.includes(p.category));

      // Fetch photo as base64
      let photoData: string | null = null;
      try {
        const resp = await fetch('/img/fran.jpg');
        const blob = await resp.blob();
        photoData = await new Promise<string>(resolve => {
          const reader = new FileReader();
          reader.onload = () => resolve(reader.result as string);
          reader.readAsDataURL(blob);
        });
      } catch (_) { /* photo optional */ }

      // ── Color palettes ─────────────────────────────────────────────────
      const SIDEBAR_W = 185;
      const A4_W = 595;

      const palette = theme === 'dark' ? {
        SIDEBAR_BG:  '#161b22',
        MAIN_BG:     '#0d1117',
        NAME:        '#e6edf3',
        HEADLINE:    '#00ff87',
        LABEL:       '#ffb800',
        CONTACT:     '#8b949e',
        SKILL_FG:    '#00ff87',
        SKILL_BG:    '#21262d',
        SKILL_TEXT:  '#e6edf3',
        CMD:         '#00ff87',
        CMD_PROJ:    '#00d4ff',
        EXP_TITLE:   '#e6edf3',
        EXP_COMPANY: '#00d4ff',
        EXP_MUTED:   '#8b949e',
        PROJ_TITLE:  '#e6edf3',
        PROJ_ROLE:   '#00d4ff',
        PROJ_TECH:   '#00ff87',
        PROJ_DESC:   '#8b949e',
        SUMMARY:     '#8b949e',
        DEFAULT:     '#e6edf3',
      } : {
        SIDEBAR_BG:  '#eef2f7',
        MAIN_BG:     '#ffffff',
        NAME:        '#1a202c',
        HEADLINE:    '#2563eb',
        LABEL:       '#2563eb',
        CONTACT:     '#4a5568',
        SKILL_FG:    '#2563eb',
        SKILL_BG:    '#dbe4f0',
        SKILL_TEXT:  '#1a202c',
        CMD:         '#1a4480',
        CMD_PROJ:    '#1a4480',
        EXP_TITLE:   '#1a202c',
        EXP_COMPANY: '#2563eb',
        EXP_MUTED:   '#4a5568',
        PROJ_TITLE:  '#1a202c',
        PROJ_ROLE:   '#2563eb',
        PROJ_TECH:   '#1a4480',
        PROJ_DESC:   '#4a5568',
        SUMMARY:     '#4a5568',
        DEFAULT:     '#1a202c',
      };

      function fmt(date: string | null | undefined): string {
        if (!date) return lang === 'pt' ? 'atual' : 'present';
        const [y, m] = date.split('-');
        const enM = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        const ptM = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
        return `${(lang === 'pt' ? ptM : enM)[parseInt(m) - 1]} ${y}`;
      }

      // ── Sidebar ─────────────────────────────────────────────────────────
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      const sidebarItems: any[] = [];

      if (photoData) {
        sidebarItems.push({ image: photoData, width: 72, height: 72, alignment: 'center', margin: [0, 0, 0, 10] });
      }

      sidebarItems.push(
        { text: d.name?.toUpperCase() ?? '', fontSize: 10, bold: true, color: palette.NAME, alignment: 'center', margin: [0, 0, 0, 4] },
        { text: lang === 'pt' ? d.headline?.pt : d.headline?.en, fontSize: 6.5, color: palette.HEADLINE, alignment: 'center', margin: [0, 0, 0, 14], lineHeight: 1.3 },
        { text: 'CONTACT', fontSize: 7, bold: true, color: palette.LABEL, margin: [0, 0, 0, 5] },
        { text: d.contact?.email ?? '', fontSize: 7, color: palette.CONTACT, margin: [0, 0, 0, 2] },
        { text: d.contact?.github ?? '', fontSize: 7, color: palette.CONTACT, margin: [0, 0, 0, 2] },
        { text: d.contact?.site ?? '', fontSize: 7, color: palette.CONTACT, margin: [0, 0, 0, 2] },
        { text: lang === 'pt' ? (d.contact?.city?.pt ?? '') : (d.contact?.city?.en ?? ''), fontSize: 7, color: palette.CONTACT, margin: [0, 0, 0, 14] },
        { text: 'SKILLS', fontSize: 7, bold: true, color: palette.LABEL, margin: [0, 0, 0, 7] },
      );

      (d.skills ?? []).forEach((skill: { name: string; level: number }) => {
        const barW = 140;
        const fillW = Math.round(barW * skill.level / 100);
        sidebarItems.push({
          stack: [
            { text: skill.name, fontSize: 7, color: palette.SKILL_TEXT },
            { canvas: [
              { type: 'rect', x: 0, y: 2, w: barW, h: 4, color: palette.SKILL_BG, r: 2 },
              { type: 'rect', x: 0, y: 2, w: fillW, h: 4, color: palette.SKILL_FG, r: 2 },
            ]},
          ],
          margin: [0, 0, 0, 6],
        });
      });

      sidebarItems.push({ text: 'EDUCATION', fontSize: 7, bold: true, color: palette.LABEL, margin: [0, 12, 0, 7] });
      (d.education ?? []).forEach((edu: { institution: string; degree: { en: string; pt: string }; startYear: number; endYear: number }) => {
        sidebarItems.push({
          stack: [
            { text: edu.institution, fontSize: 7, color: palette.SKILL_TEXT, bold: true },
            { text: lang === 'pt' ? edu.degree.pt : edu.degree.en, fontSize: 6.5, color: palette.CONTACT },
            { text: `${edu.startYear} – ${edu.endYear}`, fontSize: 6.5, color: palette.CONTACT },
          ],
          margin: [0, 0, 0, 8],
        });
      });

      // ── Main content ────────────────────────────────────────────────────
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      const mainItems: any[] = [];

      mainItems.push(
        { text: '$ whoami', fontSize: 9, color: palette.CMD, bold: true, margin: [0, 0, 0, 6] },
        { text: lang === 'pt' ? d.summary?.pt : d.summary?.en, fontSize: 8, color: palette.SUMMARY, lineHeight: 1.4, margin: [0, 0, 0, 18] },
        { text: '$ cat experience.log', fontSize: 9, color: palette.CMD, bold: true, margin: [0, 0, 0, 8] },
      );

      (d.experience ?? []).forEach((exp: {
        company: string;
        position: { en: string; pt: string };
        startDate: string;
        endDate: string | null;
        location: { en: string; pt: string };
        description: { en: string; pt: string };
      }) => {
        mainItems.push({
          stack: [
            {
              columns: [
                { text: lang === 'pt' ? exp.position.pt : exp.position.en, fontSize: 9, bold: true, color: palette.EXP_TITLE, width: '*' },
                { text: `${fmt(exp.startDate)} – ${fmt(exp.endDate)}`, fontSize: 7, color: palette.EXP_MUTED, alignment: 'right', width: 'auto' },
              ],
            },
            { text: exp.company, fontSize: 8, color: palette.EXP_COMPANY, margin: [0, 2, 0, 2] },
            { text: lang === 'pt' ? exp.location.pt : exp.location.en, fontSize: 7, color: palette.EXP_MUTED, margin: [0, 0, 0, 2] },
            { text: lang === 'pt' ? exp.description.pt : exp.description.en, fontSize: 7.5, color: palette.EXP_MUTED, lineHeight: 1.3 },
          ],
          margin: [0, 0, 0, 10],
        });
      });

      if (filtered.length > 0) {
        mainItems.push({ text: '$ ls projects/ | sort -r', fontSize: 9, color: palette.CMD_PROJ, bold: true, margin: [0, 10, 0, 8] });
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        filtered.forEach((proj: any) => {
          mainItems.push({
            stack: [
              {
                columns: [
                  { text: lang === 'pt' ? proj.titlePt : proj.title, fontSize: 9, bold: true, color: palette.PROJ_TITLE, width: '*' },
                  { text: `${fmt(proj.startDate)} – ${fmt(proj.endDate)}`, fontSize: 7, color: palette.EXP_MUTED, alignment: 'right', width: 'auto' },
                ],
              },
              ...([proj.position, proj.company].filter(Boolean).length > 0 ? [
                { text: [proj.position, proj.company].filter(Boolean).join(' · '), fontSize: 8, color: palette.PROJ_ROLE, margin: [0, 2, 0, 2] },
              ] : []),
              { text: (proj.tech as string[]).slice(0, 5).join(' · '), fontSize: 7, color: palette.PROJ_TECH, margin: [0, 0, 0, 2] },
              { text: lang === 'pt' ? proj.descriptionPt : proj.description, fontSize: 7.5, color: palette.PROJ_DESC, lineHeight: 1.3 },
            ],
            margin: [0, 0, 0, 10],
          });
        });
      }

      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      const docDefinition: any = {
        pageSize: 'A4',
        pageMargins: [0, 0, 0, 0],
        background: (_page: number, pageSize: { height: number }) => ({
          canvas: [
            // Full page background first, then sidebar overlay
            { type: 'rect', x: 0, y: 0, w: A4_W, h: pageSize.height, color: palette.MAIN_BG },
            { type: 'rect', x: 0, y: 0, w: SIDEBAR_W, h: pageSize.height, color: palette.SIDEBAR_BG },
          ],
        }),
        content: [{
          columns: [
            { width: SIDEBAR_W, stack: sidebarItems, margin: [14, 24, 10, 24] },
            { width: '*',       stack: mainItems,    margin: [18, 24, 22, 24] },
          ],
        }],
        defaultStyle: {
          font: 'Roboto',
          fontSize: 9,
          color: palette.DEFAULT,
        },
      };

      const filename = `francis-pires-cv-${theme}.pdf`;
      pdfMake.createPdf(docDefinition).download(filename);
    }

    async function handlePdfClick(btn: HTMLButtonElement, theme: 'dark' | 'light') {
      const origHTML = btn.innerHTML;
      btn.textContent = '⏳ Gerando...';
      btn.disabled = true;
      try {
        await downloadPDF(theme);
      } catch (err) {
        console.error('PDF generation failed:', err);
        alert('PDF generation failed. Check the console for details.');
      } finally {
        btn.innerHTML = origHTML;
        btn.disabled = false;
      }
    }

    document.getElementById('pdf-btn-dark')?.addEventListener('click', () => {
      handlePdfClick(document.getElementById('pdf-btn-dark') as HTMLButtonElement, 'dark');
    });
    document.getElementById('pdf-btn-light')?.addEventListener('click', () => {
      handlePdfClick(document.getElementById('pdf-btn-light') as HTMLButtonElement, 'light');
    });
  </script>

  <style>
    .cv-page {
      max-width: var(--wide-width);
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }

    /* ── Header ──────────────────────────────────────────────────────── */
    .cv-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
    }

    .cmd-prefix {
      color: var(--green);
      font-size: 0.75rem;
      display: block;
      margin-bottom: 0.25rem;
    }

    .cv-title {
      font-size: 1.5rem;
      color: var(--text);
    }

    .cv-header-right {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .filter-chips {
      display: flex;
      gap: 0.375rem;
      flex-wrap: wrap;
    }

    .cat-chip {
      background: color-mix(in srgb, var(--chip-color) 14%, transparent);
      color: var(--chip-color);
      border: 1px solid color-mix(in srgb, var(--chip-color) 40%, transparent);
      border-radius: 3px;
      padding: 0.2rem 0.6rem;
      font-size: 0.7rem;
      font-family: var(--font-mono);
      cursor: pointer;
      transition: background 0.15s, color 0.15s, border-color 0.15s;
    }

    .cat-chip:not(.active) {
      background: var(--bg-elevated);
      color: var(--text-muted);
      border-color: var(--border);
    }

    .pdf-btn {
      border: none;
      border-radius: 3px;
      padding: 0.35rem 1rem;
      font-size: 0.75rem;
      font-family: var(--font-mono);
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
      transition: opacity 0.15s;
    }

    .pdf-btn-dark {
      background: #161b22;
      color: var(--green);
      border: 1px solid var(--border);
    }

    .pdf-btn-light {
      background: #f0f4f8;
      color: #1a4480;
      border: 1px solid #d0d8e8;
    }

    .pdf-btn:hover:not(:disabled) { opacity: 0.8; }
    .pdf-btn:disabled { opacity: 0.5; cursor: not-allowed; }

    /* ── Two-column body ──────────────────────────────────────────────── */
    .cv-body {
      display: flex;
      border: 1px solid var(--border);
      border-radius: 6px;
      overflow: hidden;
    }

