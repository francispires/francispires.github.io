---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getCollection } from 'astro:content';

const stripDate = (slug) => slug.replace(/^\d{4}-\d{2}-\d{2}-/, '');

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => import.meta.env.PROD ? !data.draft : true);
  return posts.map(post => ({
    params: { slug: stripDate(post.slug) },
    props: { post },
  }));
}

const { post } = Astro.props;

// Find bilingual counterpart
const allPosts = await getCollection('blog', ({ data }) => import.meta.env.PROD ? !data.draft : true);
const translation = post.data.translationKey
  ? allPosts.find(
      p =>
        p.data.translationKey === post.data.translationKey &&
        p.slug !== post.slug
    )
  : undefined;

const translationUrl = translation ? `/blog/${stripDate(translation.slug)}` : undefined;

const { Content } = await post.render();
---

<BlogLayout post={post} translationUrl={translationUrl}>
  <Content />
</BlogLayout>
