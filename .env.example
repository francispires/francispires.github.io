# ── Core (required) ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...          # Claude API — content generation & translation

# ── Images (optional) ─────────────────────────────────────────────────────────
UNSPLASH_ACCESS_KEY=...               # Unsplash photo search (free tier: 50 req/hr)
OPENAI_API_KEY=sk-...                 # DALL-E 3 image generation (pay-per-use)

# ── LinkedIn publishing ───────────────────────────────────────────────────────
# Setup: see docs/LINKEDIN-SETUP.md
LINKEDIN_CLIENT_ID=...                # LinkedIn app Client ID
LINKEDIN_CLIENT_SECRET=...            # LinkedIn app Client Secret
LINKEDIN_ACCESS_TOKEN=                # Auto-set after first OAuth flow (60-day token)
LINKEDIN_PERSON_URN=                  # Auto-set after first OAuth flow

# ── Instagram publishing ──────────────────────────────────────────────────────
# Setup: see docs/INSTAGRAM-SETUP.md
INSTAGRAM_APP_ID=...                  # Meta app App ID
INSTAGRAM_APP_SECRET=...              # Meta app App Secret
FACEBOOK_ACCESS_TOKEN=                # Auto-set after first OAuth flow (60-day token)
INSTAGRAM_BUSINESS_ACCOUNT_ID=        # Auto-set after first OAuth flow
